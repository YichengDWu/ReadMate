{
  "manifest_version": 3,
  "name": "ReadMate - AI Selection TTS & Read-Along",
  "description": "Select text on any page and read it aloud with AI TTS and word highlighting.",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.inworld.ai/*",
    "https://api.cartesia.ai/*",
    "https://api.fish.audio/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ReadMate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
